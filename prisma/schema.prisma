generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  whatsapp    String?
  service     String
  addlService String?
  budget      String?
  message     String
  status      String   @default("new") // new | contacted | in_progress | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  status           String    @default("pending") // pending | confirmed | unsubscribed
  confirmToken     String?   @unique
  unsubscribeToken String?   @unique
  confirmedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String
  tags        String    @default("[]") // JSON-serialized string array
  author      String    @default("OKOMBA ANALYTICS")
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  notifySentAt DateTime? // when subscriber email blast was sent
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model EmailLog {
  id           String   @id @default(cuid())
  type         String   // post.published | subscriber.welcome | broadcast | inquiry.receipt
  recipientEmail String
  subject      String
  postId       String?
  subscriberId String?
  status       String   @default("sent") // queued | sent | failed
  error        String?
  sentAt      DateTime  @default(now())

  @@index([postId])
  @@index([subscriberId])
  @@index([sentAt])
}
