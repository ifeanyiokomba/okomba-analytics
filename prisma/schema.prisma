generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // ── Phase 29 fix: directUrl removed ─────────────────────────
  // Prisma's directUrl is recommended for Neon when DATABASE_URL is
  // the PgBouncer-pooler endpoint, because PgBouncer's transaction
  // mode doesn't support all DDL operations Prisma migrations use.
  // HOWEVER, modern Neon's pooler supports `prisma db push` fine,
  // and forcing a separate DIRECT_URL env var caused P1012 on Render
  // (the env var wasn't set there, breaking every deploy).
  // Removing directUrl means Prisma uses DATABASE_URL for everything
  // — one env var to configure, deploys succeed.
  // If we ever hit "prepared statement ... does not exist" or similar
  // pooler-mode errors during db push, re-add:
  //   directUrl = env("DIRECT_URL")
  // and set DIRECT_URL on Render to the non-pooler Neon hostname.
}

// ── SQLite → PostgreSQL migration (Phase 28) ─────────────────
// Provider switched from `sqlite` to `postgresql`. JSON-as-String
// fields (tags, attachments, lessons, customFields, meta, payload,
// result, draftJson, proposalJson) were converted to native Prisma
// `Json` type. Defaults remain JSON literals so empty rows still
// serialize to `[]` / `{}` in the new column. App code that calls
// `JSON.parse(...)` on these fields must be updated to consume the
// already-parsed object/Array; the migration script handles the
// conversion from SQLite TEXT → PostgreSQL jsonb.

model Inquiry {
  id          String   @id @default(cuid())
  name        String   // legacy display/compat field — kept; new contract uses firstName+lastName
  firstName   String?  // ── BATCH 1: Customer Identity Contract (directive §5,§48) ──
  lastName    String?  //   new submissions store these explicitly (no name.split)
  countryCode String?  //   ISO-2 (NG | GH | US | GB | …) — backend-only authority (§7)
  customerId  String?  //   link to canonical Customer row created on submission (§28)
  email       String
  phone       String?
  whatsapp    String?
  service     String
  addlService String?
  budget      String?
  message     String
  status      String   @default("new") // new | contacted | in_progress | closed
  source      String   @default("website") // website | ai_chat (Module 7 AI Service Finder)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([countryCode])
  @@index([customerId])
}

/* ── Phase-2 Module 7: AI Service Finder leads ────────────────
   When the AI chat widget qualifies a visitor and captures their
   email, a draft proposal is auto-created so it appears in the
   admin Proposals tab ready to review and send.                    */
model DraftProposal {
  id              String   @id @default(cuid())
  source          String   @default("ai_chat") // ai_chat | admin
  customerName    String
  customerEmail   String
  service         String   // primary recommended service (title)
  draftJson       Json     // ProposalDraft JSON snapshot (price-scrubbed)
  leadScore       Int?     // 1–10, rated by the AI from chat signals
  inquiryId       String?  @unique // link into the Inquiries workflow
  receivedEmailId String?  // link to the received_emails lead row
  status          String   @default("draft") // draft | sent | discarded
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

/* ── Phase-2 Module 7: Paystack webhook audit log ─────────────
   Every incoming webhook (charge.success, transfer.success, …)
   is persisted here — the money trail the admin can inspect.       */
model WebhookLog {
  id             String    @id @default(cuid())
  provider       String    @default("paystack")
  event          String
  paystackId     String? // data.id — Paystack event id (dedup key)
  reference      String? // data.reference
  invoiceId      String?
  invoiceNumber  String?
  amountKobo     Int?
  currency       String?
  signatureValid Boolean   @default(false)
  source         String    @default("webhook") // webhook | admin-test
  status         String    @default("received") // received | processed | failed | ignored | duplicate
  result         Json      @default("{}") // JSON outcome detail
  payload        Json      @default("{}") // JSON snapshot (trimmed)
  error          String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@unique([provider, event, paystackId])
  @@index([receivedAt])
  @@index([invoiceId])
  @@index([status])
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  status           String    @default("pending") // pending | confirmed | unsubscribed
  confirmToken     String?   @unique
  unsubscribeToken String?   @unique
  confirmedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String
  tags        Json      @default("[]") // JSON-serialized string array
  author      String    @default("OKOMBA ANALYTICS")
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  notifySentAt DateTime? // when subscriber email blast was sent
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   // e.g. "Founder, TechStartNG"
  service   String   // e.g. "Web Development"
  text      String   // the quote
  rating    Int      @default(5) // 1-5 stars
  avatar    String?  // optional image path like /images/avatar-x.png
  status    String   @default("published") // draft | published
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model EmailLog {
  id           String   @id @default(cuid())
  type         String   // post.published | subscriber.welcome | broadcast | inquiry.created | invoice.sent
  recipientEmail String
  subject      String
  postId       String?
  subscriberId String?
  status       String   @default("sent") // queued | sent | failed
  error        String?
  sentAt      DateTime  @default(now())
  // ── Phase-1 audit extensions (sent_emails contract) ──
  bodyText     String?  // plain-text version
  bodyHtml     String?  // branded HTML version
  attachments  Json     @default("[]") // JSON [{filename, size, storageUrl?}]
  invoiceId    String?  // related invoice when type=invoice.sent
  // ── Phase 29: which provider actually delivered this email ──
  // (apps_script | resend | mailtrap | maileroo). Null = legacy
  // NOTIFY_WEBHOOK_URL delivery (pre-failover or stub mode).
  provider     String?  @default("apps_script")

  @@index([postId])
  @@index([subscriberId])
  @@index([sentAt])
  @@index([invoiceId])
}

/* ── Phase 29: AES-256-GCM-encrypted email provider credentials ──
   The failover chain (apps_script → resend → mailtrap → maileroo)
   iterates enabled rows in `priority` order (lower = tried first).
   `credentialsEnc` is base64(iv|ciphertext|tag) — never plaintext.
   Rotation requires re-entering all credentials because the
   encryption key is what makes the ciphertext readable.                */
model EmailProviderConfig {
  id              String   @id @default(cuid())
  provider        String   @unique // apps_script | resend | mailtrap | maileroo
  displayName     String   // "Google Apps Script" | "Resend" | "Mailtrap" | "Maileroo"
  priority        Int      @default(0) // 1=primary, 2=secondary, etc. Lower = tried first.
  enabled         Boolean  @default(true)
  // AES-256-GCM encrypted blob: { apiKey?, webhookUrl?, fromEmail?, fromName?, apiEndpoint? }
  credentialsEnc  String   // base64(iv|ciphertext|tag)
  // Last test result (set by /api/admin/email-config/test)
  lastTestAt      DateTime?
  lastTestStatus  String?  // success | failed
  lastTestError   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, priority])
}

/* ── Phase-1 Module 2: audit-trail models ────────────────────
   Directive asked for Mongoose models; this stack is Prisma +
   SQLite (deployed on Render with a persistent disk — migrating
   to Mongo would break the deployment kit and every preserved
   workflow). Equivalent Prisma models deliver the same audit
   goals without the regression. Mappings:
     received_emails → ReceivedEmail
     sent_emails     → EmailLog (extended above — the admin Email
                       log UI already reads it; a duplicate table
                       would drift)
     invoices        → Invoice
     events          → EventRecord
     whatsapp_messages → WhatsAppMessage                    */
model ReceivedEmail {
  id         String   @id @default(cuid())
  source     String   @default("contact") // contact | ai_chat | manual
  name       String?
  email      String?
  phone      String?
  subject    String?
  message    String
  leadScore  Int?     // 0–100, set by ai_chat qualification (Phase 3)
  meta       Json     @default("{}") // JSON: { service, budget, extra }
  inquiryId  String?  // link to the Inquiry workflow row
  createdAt  DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

model Invoice {
  id               String    @id @default(cuid())
  invoiceNumber    String    @unique // INV-2026-0001
  inquiryId        String?
  // ── BATCH 1: Invoice → Customer relation (directive §23) ──
  // Customer owns the DVA; the invoice snapshots the customer's current
  // DVA at creation time for historical presentation (§9,§33,§45).
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  customerName     String   // legacy display/snapshot (kept for compat)
  customerEmail    String
  customerPhone    String?
  service          String
  description      String?
  proposalJson     Json?     // full (admin-edited) proposal snapshot — powers PDF regeneration & reminders
  amountKobo       Int       // NGN minor units — integer math, no float drift
  currency         String    @default("NGN")
  durationLabel    String?   // e.g. "3 weeks"
  dueDate          DateTime?
  status           String    @default("draft") // draft | sent | pending | paid | overdue | cancelled
  // Paystack Dedicated Virtual Account — INVOICE-LEVEL SNAPSHOT (§33,§45)
  dvaAccountId     String?  // snapshot of Customer.dvaAccountId at send time
  dvaAccountNumber String?
  dvaAccountName   String?  // ── BATCH 1: extended snapshot fields (§33) ──
  dvaBankName      String?
  dvaBankCode      String?
  dvaBankSlug      String?  // provider_slug snapshot
  dvaProvider      String?
  dvaCurrency      String?
  // ── Audit fix (Phase 27): unique Paystack transaction reference ──
  // Bound at DVA creation / checkout-session time so the webhook can
  // match a payment to its invoice by an immutable reference (NOT by
  // email + amount, which can collide across multiple open invoices).
  // NULL until the DVA / checkout session is provisioned.
  paystackReference String? @unique
  pdfUrl           String?   // Cloudinary URL (Module 8B) or local fallback label
  pdfStorage       String?   // cloudinary | local
  // ── Module 8A: Client Portal (/portal/{secureToken}) ──
  secureToken          String?   @unique // 192-bit random URL token (no auth by design)
  portalViewedAt       DateTime? // first portal visit timestamp
  // ── Module 8A: "I've Paid" proof upload ──
  paymentProofUrl      String?   // stored file path/label
  paymentProofName     String?
  paymentProofUploadedAt DateTime?
  paidAt           DateTime?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── BATCH 1: relation from Payment.invoiceId ──
  payments Payment[]

  @@index([status])
  @@index([dueDate])
  @@index([customerEmail])
  @@index([customerId])
}

/* ── BATCH 1: Payment record (directive §26) ───────────────────
   A dedicated Payment entity separate from WebhookLog — the canonical
   "money received" record. Created on webhook charge.success or on
   manual reconciliation. WebhookLog remains the raw audit trail; this
   Payment row is the normalized, customer+invoice-linked record the
   admin CRM's "Payment history" panel reads (directive §44).        */
model Payment {
  id                    String    @id @default(cuid())
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id])
  invoiceId             String?
  invoice               Invoice?  @relation(fields: [invoiceId], references: [id])
  provider              String    @default("paystack") // paystack | manual | other
  providerTransactionId String?  // Paystack's data.id (event-level) or transaction.id
  reference             String?  @unique // data.reference — idempotency key (§26)
  amountMinor           Int      // kobo (NGN) or pesewas (GHS) — minor units, integer math
  currency              String   @default("NGN")
  channel               String?  // bank_transfer | card | ussd | bank | mobile_money | ...
  accountNumber         String?  // DVA account number if payment came through DVA
  status                String   @default("pending") // pending | successful | failed | reversed | ambiguous
  paidAt                DateTime?
  rawMetadata           String    @default("{}") // bounded JSON snapshot of provider payload
  webhookLogId          String?  // link back to the audit row in WebhookLog
  reconciledAt          DateTime? // set when matched to an invoice (success OR manual)
  reconciledBy          String?  // "auto" | "admin" | null
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([reference])
  @@index([providerTransactionId])
}

model EventRecord {
  id               String    @id @default(cuid())
  type             String    // invoice.reminder_3d | proposal.sent | payment.expected
  customerEmail    String?
  customerPhone    String?
  eventDate        DateTime
  relatedInvoiceId String?
  payload          Json      @default("{}") // JSON snapshot for the handler
  status           String    @default("scheduled") // scheduled | processed | skipped | failed
  processedAt      DateTime?
  lastSentAt       DateTime? // last time a reminder for this event actually went out
  createdAt        DateTime  @default(now())

  @@index([eventDate])
  @@index([status])
  @@index([relatedInvoiceId, type])
}

model WhatsAppMessage {
  id               String   @id @default(cuid())
  direction        String   // inbound | outbound
  toPhone          String?
  fromPhone        String?
  messageText      String?
  mediaUrl         String?
  mediaFilename    String?
  relatedInvoiceId String?
  status           String   @default("queued") // queued | sent | failed (outbound only)
  sentAt           DateTime @default(now())

  @@index([sentAt])
  @@index([toPhone])
  @@index([fromPhone])
  @@index([relatedInvoiceId])
}

/* ── Phase-2 Module 8C: first-party analytics events ─────────
   GA4 receives the same names via dataLayer/gtag; this table is
   the source of truth the Admin Analytics dashboard queries
   (works with or without a GA4 property configured).               */
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // ai_chat_start | portal_visit | proposal_view | pdf_download | payment_click | payment_proof_uploaded
  invoiceId   String?
  secureToken String?
  sessionId   String? // AI chat session grouping
  meta        Json     @default("{}") // JSON: { service, source, … }
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([invoiceId])
  @@index([sessionId])
}

/* ── Phase-2 Module 8B: daily 02:00 backup audit trail ────────
   Every backup run (Google Drive target when credentials exist,
   local rotation fallback otherwise) is recorded here.             */
model BackupLog {
  id         String   @id @default(cuid())
  kind       String   @default("db") // db | uploads
  target     String   @default("gdrive") // gdrive | local
  status     String   @default("success") // success | failed
  fileName   String?
  sizeBytes  Int?
  durationMs Int?
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/* ── Stage 11 CRM: canonical Customer record ─────────────────────
   The CRM unifies Inquiries + Invoices + EmailLog + WhatsAppMessage
   + Subscribers by customerEmail. A Customer row is the canonical
   contact: name, email, phone, whatsapp, company, status, tags,
   notes (free-text), source (manual | csv | inquiry | ai_chat |
   invoice), and an internal notes trail.

   Why a separate Customer table vs. just virtualizing off Inquiries:
   - Lets the admin add prospects that haven't submitted an inquiry
     yet (e.g. from a CSV upload, a networking event, a referral).
   - Gives the admin a stable ID to attach notes / tags / status to,
     independent of which channel the contact came in through.
   - Makes the CRM searchable + filterable in one query (no N-table
     union needed at render time).

   The detail view still aggregates interactions from the existing
   tables by customerEmail so historical rows created BEFORE the CRM
   feature ship are visible too — zero migration needed.           */
model Customer {
  id          String   @id @default(cuid())
  name        String   // legacy display/compat field — kept; new contract uses firstName+lastName
  // ── BATCH 1: Customer Identity Contract (directive §5,§10) ──
  firstName   String?  // canonical first name (no name.split for new rows)
  lastName    String?  // canonical last name
  countryCode String?  // ISO-2 — backend authority for DVA eligibility (§7,§8)
  email       String   @unique
  phone       String?
  whatsapp    String?
  company     String?
  role        String?  // e.g. "Founder, TechStartNG"
  status      String   @default("lead") // lead | qualified | proposal_sent | paying | churned | blocked
  tags        Json     @default("[]") // JSON string array — flexible taxonomy
  notes       String?  // free-text internal notes (latest snapshot)
  source      String   @default("manual") // manual | csv | excel | inquiry | ai_chat | invoice | broadcast
  // Lead-scoring (0-100) — set by AI on CSV import or by admin manually.
  leadScore   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Convenience flags surfaced on the list view (denormalized for perf)
  lastContactAt DateTime? // most recent of: inquiry createdAt / invoice sentAt / email sentAt

  // ── BATCH 1: Paystack Customer identity (directive §10,§13) ──
  // Customer → Paystack Customer → DVA — DVA is CUSTOMER-OWNED, not invoice-owned.
  // Invoices snapshot the customer's current DVA at creation time.
  paystackCustomerId  String?  // Paystack numeric customer id (e.g. 1234567890)
  paystackCustomerCode String? // Paystack CUS_xxx customer code

  // ── BATCH 1: Canonical DVA on Customer (directive §9,§10,§12,§20) ──
  dvaAccountId    String?  // Paystack's DVA account id — supports GET/DELETE by id (§12,§37)
  dvaAccountNumber String?
  dvaAccountName  String?
  dvaBankName     String?
  dvaBankCode     String?
  dvaBankSlug     String?  // e.g. "wema-bank" — persisted from available_providers (§16,§20)
  dvaProvider     String?  // provider_slug actually returned by Paystack
  dvaCurrency     String?  // NGN | GHS — driven by country (§27)
  dvaStatus       String?  // not_eligible | eligible | pending | active | failed | deactivated | requires_validation (§11)
  dvaAssignedAt   DateTime?
  dvaUpdatedAt    DateTime?

  // ── BATCH 1: relation from Invoice.customerId + Payment.customerId ──
  invoices  Invoice[]
  payments  Payment[]

  @@index([status])
  @@index([source])
  @@index([lastContactAt])
  @@index([leadScore])
  @@index([countryCode])
  @@index([dvaStatus])
  @@index([paystackCustomerCode])
}

/* ── Stage 11 CRM: internal note trail per customer ───────────── */
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  author     String   @default("admin")
  body       String
  // Optional context — what triggered the note?
  context    String?  // call | email | whatsapp | meeting | referral | misc
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

/* ── Stage 11 CRM: admin-to-customer message log ────────────────
   Records every outbound message sent FROM the admin CRM. The
   actual delivery is via the existing email pipeline (notify.ts →
   Apps Script for branded Gmail) and the WhatsApp mini-service.
   Replies come back via the inbound WhatsApp + email-poll routes
   and land in WhatsAppMessage / ReceivedEmail — the CRM detail
   view aggregates both sides into one timeline.                              */
model CustomerMessage {
  id          String   @id @default(cuid())
  customerId  String?
  toEmail     String
  toPhone     String?
  channel     String   // email | whatsapp
  subject     String?
  body        String
  status      String   @default("queued") // queued | sent | failed
  error       String?
  sentAt      DateTime @default(now())

  @@index([customerId])
  @@index([channel])
  @@index([sentAt])
}
