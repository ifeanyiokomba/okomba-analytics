generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  whatsapp    String?
  service     String
  addlService String?
  budget      String?
  message     String
  status      String   @default("new") // new | contacted | in_progress | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  status           String    @default("pending") // pending | confirmed | unsubscribed
  confirmToken     String?   @unique
  unsubscribeToken String?   @unique
  confirmedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String
  tags        String    @default("[]") // JSON-serialized string array
  author      String    @default("OKOMBA ANALYTICS")
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  notifySentAt DateTime? // when subscriber email blast was sent
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   // e.g. "Founder, TechStartNG"
  service   String   // e.g. "Web Development"
  text      String   // the quote
  rating    Int      @default(5) // 1-5 stars
  avatar    String?  // optional image path like /images/avatar-x.png
  status    String   @default("published") // draft | published
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model EmailLog {
  id           String   @id @default(cuid())
  type         String   // post.published | subscriber.welcome | broadcast | inquiry.created | invoice.sent
  recipientEmail String
  subject      String
  postId       String?
  subscriberId String?
  status       String   @default("sent") // queued | sent | failed
  error        String?
  sentAt      DateTime  @default(now())
  // ── Phase-1 audit extensions (sent_emails contract) ──
  bodyText     String?  // plain-text version
  bodyHtml     String?  // branded HTML version
  attachments  String   @default("[]") // JSON [{filename, size, storageUrl?}]
  invoiceId    String?  // related invoice when type=invoice.sent

  @@index([postId])
  @@index([subscriberId])
  @@index([sentAt])
  @@index([invoiceId])
}

/* ── Phase-1 Module 2: audit-trail models ────────────────────
   Directive asked for Mongoose models; this stack is Prisma +
   SQLite (deployed on Render with a persistent disk — migrating
   to Mongo would break the deployment kit and every preserved
   workflow). Equivalent Prisma models deliver the same audit
   goals without the regression. Mappings:
     received_emails → ReceivedEmail
     sent_emails     → EmailLog (extended above — the admin Email
                       log UI already reads it; a duplicate table
                       would drift)
     invoices        → Invoice
     events          → EventRecord
     whatsapp_messages → WhatsAppMessage                    */
model ReceivedEmail {
  id         String   @id @default(cuid())
  source     String   @default("contact") // contact | ai_chat | manual
  name       String?
  email      String?
  phone      String?
  subject    String?
  message    String
  leadScore  Int?     // 0–100, set by ai_chat qualification (Phase 3)
  meta       String   @default("{}") // JSON: { service, budget, extra }
  inquiryId  String?  // link to the Inquiry workflow row
  createdAt  DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

model Invoice {
  id               String    @id @default(cuid())
  invoiceNumber    String    @unique // INV-2026-0001
  inquiryId        String?
  customerName     String
  customerEmail    String
  customerPhone    String?
  service          String
  description      String?
  proposalJson     String?   // full (admin-edited) proposal snapshot — powers PDF regeneration & reminders
  amountKobo       Int       // NGN minor units — integer math, no float drift
  currency         String    @default("NGN")
  durationLabel    String?   // e.g. "3 weeks"
  dueDate          DateTime?
  status           String    @default("draft") // draft | sent | pending | paid | overdue | cancelled
  // Paystack Dedicated Virtual Account (populated Phase 2)
  dvaAccountNumber String?
  dvaBankName      String?
  dvaBankCode      String?
  pdfUrl           String?   // Cloudinary URL (populated Phase 2)
  paidAt           DateTime?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([customerEmail])
}

model EventRecord {
  id               String    @id @default(cuid())
  type             String    // invoice.reminder_3d | proposal.sent | payment.expected
  customerEmail    String?
  customerPhone    String?
  eventDate        DateTime
  relatedInvoiceId String?
  payload          String    @default("{}") // JSON snapshot for the handler
  status           String    @default("scheduled") // scheduled | processed | skipped | failed
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([eventDate])
  @@index([status])
}

model WhatsAppMessage {
  id               String   @id @default(cuid())
  direction        String   // inbound | outbound
  toPhone          String?
  fromPhone        String?
  messageText      String?
  mediaUrl         String?
  mediaFilename    String?
  relatedInvoiceId String?
  sentAt           DateTime @default(now())

  @@index([sentAt])
}
