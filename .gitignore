# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Local runtime artifacts — never publish
/tool-results/
/agent-ctx/
/upload/
db/custom.db
db/*.db
screenshots/
# Local DB snapshots — produced by the Module 8B backup engine.
# Don't version them: each .db is a binary snapshot of the live DB
# at a point in time; committing them bloats git history + leaks
# whatever test data was in the DB. The download endpoint serves
# them on-demand to authenticated admins.
data/backups/*.db
data/uploads/
# Never commit customer-facing PDFs (proofs, proposals, receipts) — even
# when generated by e2e tests. They may contain real customer data.
e2e-shots/**/*-INV-*.pdf
e2e-shots/**/*receipt*.pdf
e2e-shots/**/*.db

# Runtime PID / state files (auto-updated by dev.sh + cron job)
.zscripts/dev.pid
.zscripts/*.pid
mini-services/**/data/
mini-services/**/node_modules/
# Local SQLite dev twin of the Prisma client (dual-provider setup).
# Generated by `bun run db:local` — see scripts/make-sqlite-schema.mjs.
# The production client (src/generated/prisma) stays committed because
# both deploy paths (render.yaml buildCommand, Dockerfile) regenerate it.
src/generated/prisma-sqlite/
# Local SQLite schema variant (derived, not canonical)
prisma/schema.sqlite.prisma
