# Okomba Analytics — environment configuration
# Copy to .env and adjust values. NEVER commit the real .env file.

# ── Phase 28: PostgreSQL on Neon (was SQLite) ─────────────────
# We migrated from local SQLite to a managed Neon PostgreSQL cluster so
# the database isn't tied to a single Render instance / persistent disk.
#
# Neon gives you TWO hostnames per database:
#   1. the pooled hostname  (…-pooler.aws.neon.tech) — recommended for
#      the app runtime; PgBouncer sits in front so you don't burn
#      connections under load.
#   2. the direct hostname  (the same host WITHOUT `-pooler`) — used by
#      Prisma migrations / `db push` because those need a real
#      Postgres session, not a pooled one.
#
# Prisma reads both URLs from env at build/startup:
#   DATABASE_URL  → runtime pooler URL (with pgbouncer=true)
#   DIRECT_URL    → migration direct URL (no pgbouncer param)
#
# Template (replace USER:PASS@HOST with your Neon values):
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15&connection_limit=10"
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
#
# On Render, set BOTH DATABASE_URL and DIRECT_URL as environment variables
# in the web service → Environment tab. The persistent disk (/data) is no
# longer required for the DB itself, but the WhatsApp service still uses
# its own /data disk for the WhatsApp-Web.js session.
DATABASE_URL=postgresql://user:pass@your-neon-pooler-host.neon.tech/dbname?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15&connection_limit=10
DIRECT_URL=postgresql://user:pass@your-neon-direct-host.neon.tech/dbname?sslmode=require

# Admin portal credentials — REQUIRED in production.
# If unset, source-level dev defaults are used (see src/app/api/admin/login/route.ts).
# Always override these when deploying publicly.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Email notifications (Google Apps Script pattern) ─────────
# Deploy Google-apps-script/Code.gs as a Web App (see docs/DEPLOYMENT.md),
# then paste the Web App URL here — every notification (inquiry alerts +
# confirmations, subscriber double-opt-in, new-post blasts, broadcasts)
# is forwarded there and sent via your Gmail. Leave unset to log-only.
#
# Phase 29 NOTE: this is the LEGACY single-provider path. The new
# multi-provider failover chain (apps_script → resend → mailtrap →
# maileroo) is configured via the admin Settings tab UI and stored
# encrypted in the EmailProviderConfig table. This env var is only
# consulted as a backward-compat fallback when no providers are
# configured in the DB. Once you set up the chain in the admin
# Settings tab, this env var is no longer used.
# NOTIFY_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ── Phase 29: Email failover chain encryption key ──────────────
# 32-byte AES-256-GCM key as a 64-char hex string. Used by
# src/lib/email-config.ts to encrypt provider credentials (Apps
# Script webhookUrl, Resend/Mailtrap/Maileroo apiKey, fromEmail,
# fromName) before they're stored in the EmailProviderConfig table.
#
# CRITICAL: once credentials are encrypted with this key, the key
# MUST NOT change. Rotating it requires re-entering every provider's
# credentials via the admin Settings tab (the existing ciphertext
# becomes unreadable — AES-256-GCM's auth tag will refuse to verify
# against the wrong key, so decryption fails loudly rather than
# producing garbage).
#
# Generate with: openssl rand -hex 32
# EMAIL_CONFIG_ENCRYPTION_KEY=<paste-your-64-char-hex-string-here>

# ── Phase 29: admin email-failover test recipient ─────────────
# Optional. Where the "Test" button on each provider card in the admin
# Settings tab sends a real test email. If unset, falls back to
# ADMIN_EMAIL. Can also be overridden at runtime via the Settings tab
# UI (the UI value is persisted in the EmailProviderConfig table with
# provider="test_recipient" — same encryption as real credentials).
# EMAIL_TEST_TO=you@example.com

# ───────────────────────────────────────────────────────────────
# PII GOVERNANCE — CRM import LLM opt-out (R68 / B1-B fix)
# ───────────────────────────────────────────────────────────────
# Default behavior: when the admin uploads a CSV/XLSX of contacts via
# the CRM tab → Import button, the route POST /api/admin/customers/
# import sends the spreadsheet contents (name, email, phone, WhatsApp,
# company, role, notes) to the z-ai-web-dev-sdk LLM for smart column
# mapping + auto-tagging + lead-scoring. This is convenient but it
# exfiltrates customer PII to a third-party inference endpoint.
#
# When the founder's internal policy (or a customer's DPA, or a
# regulator's guidance) prohibits that exfiltration, set
# CRM_IMPORT_NO_LLM=true (or "1", case-insensitive). The import route
# then SKIPS the LLM call entirely and uses ONLY the deterministic
# header-name heuristic fallback mapper (matches column names like
# "name"/"full name"/"first name" to the standard fields). The admin
# still gets a usable preview; they lose auto-tagging + lead-scoring,
# which they can add manually in the review step. A console.info is
# logged server-side on every import while the flag is active.
#
# Default (unset or "false"): LLM is used for smart mapping, with the
# deterministic fallback if the LLM call fails (original Phase 2
# behavior preserved).
# CRM_IMPORT_NO_LLM=false

# Public site URL — used to build confirmation links in emails.
# (Phase-1 default; overridden by the STAGE 9A PRODUCTION block below.)
# NEXT_PUBLIC_SITE_URL=https://www.okomba.com

# Set to "false" to silence all outbound notifications entirely.
# NOTIFICATIONS_ENABLED=true

# ── Phase 1 additions ─────────────────────────────────────────
# Google Analytics 4 — script only loads AFTER cookie consent.
# (Stage 10 fix: the consent-gated loader reads NEXT_PUBLIC_GA4_MEASUREMENT_ID,
#  the same var layout.tsx/analytics.ts use. The old NEXT_PUBLIC_GA_MEASUREMENT_ID
#  name is deprecated — do not use it.)
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Anti-sleep self-ping (node-cron). Point at your public URL.
# CRON_SELF_PING_ENABLED=true
# SELF_PING_URL=https://your-site.onrender.com
# CRON_SELF_PING_EXPR=0 */9 * * * *   # override for testing only

# ── Phase 2 additions ─────────────────────────────────────────
# Paystack — REQUIRED for live Dedicated Virtual Accounts on invoices.
# Without it, a clearly-labelled sandbox DVA is issued so the whole
# proposal → PDF → email pipeline still works end-to-end.
# Get keys at https://dashboard.paystack.com/#/settings/developers
# (secret keys use the sk_live_/sk_test_ prefix — paste yours from the
# Paystack dashboard; we don't put a realistic-looking key in this file)
# PAYSTACK_SECRET_KEY=<paste-your-paystack-secret-key-here>

# ── Paystack DVA preferred bank (per-country) ─────────────────────
# The checkout ROUTE is decided server-side by resolveCheckoutRoute():
#
#   • NG  → "dva_ng"           (Paystack NGN Dedicated Virtual Account)
#   • GH  → "dva_gh"           (Paystack GHS Dedicated Virtual Account)
#   • other → "standard_checkout" (POST /transaction/initialize — card,
#            mobile money, bank transfer or USSD per currency. NO DVA.)
#
# The preferred_bank env vars below ONLY affect the DVA route (NG + GH).
# They are NEVER consulted for "standard_checkout" countries (KE, ZA,
# US, GB, …) — those customers never see a virtual account number, so
# the bank choice is irrelevant; Paystack picks the available channels
# for that currency automatically at checkout time.
#
# Resolution order (first non-empty wins) per DVA country:
#   1. PAYSTACK_PREFERRED_BANK_NG  (only consulted for NG customers)
#   2. PAYSTACK_PREFERRED_BANK_GH  (only consulted for GH customers)
#   3. PAYSTACK_PREFERRED_BANK     (global fallback for any DVA country)
#   4. hard-coded default          (NG: wema-bank, GH: zenithmobilemoneyprovider)
#
# The value MUST be a `provider_slug` returned by Paystack's
# /dedicated_account/available_providers endpoint. Common NG slugs:
#   wema-bank, access-bank, zenith-bank, gtbank, sterling-bank
# Common GH slug:
#   zenithmobilemoneyprovider (and other mobile-money provider slugs
#   Paystack surfaces for GHS — confirm via the dashboard or the
#   available_providers call before overriding).
#
# If the preferred slug is unavailable for the currency, the DVA
# service falls back to a deterministic order (sort by bank_id asc) —
# provisioning never hard-fails on a bad preferred slug.
#
# PAYSTACK_PREFERRED_BANK_NG=wema-bank
# PAYSTACK_PREFERRED_BANK_GH=zenithmobilemoneyprovider
# PAYSTACK_PREFERRED_BANK=wema-bank          # global fallback (rarely needed)

# WhatsApp mini-service (Module 6, whatsapp-web.js). When set, proposal
# WhatsApp captions are dispatched immediately instead of staying queued.
# WHATSAPP_SERVICE_URL=http://localhost:3004

# ── Phase 2 Module 5+6 additions ──────────────────────────────
# WhatsApp mini-service (mini-services/whatsapp-service, port 3004).
# WHATSAPP_SERVICE_URL=http://localhost:3004
# Shared secret for internal calls between the app and the service.
# WHATSAPP_INTERNAL_TOKEN=change-me
# Reminder engine: daily 09:00 Africa/Lagos. Set false to disable.
# REMINDER_CRON_ENABLED=true
# REMINDER_CRON_EXPR=0 9 * * *

# ── Phase 2 Module 7 additions ────────────────────────────────
# Paystack webhook signature secret. Paystack signs every webhook with
# the SECRET KEY of the mode (test or live) — set this to the same key
# you configure in the Paystack dashboard webhook URL
# (https://your-domain/api/paystack/webhook). Falls back to
# PAYSTACK_SECRET_KEY when unset. A dev-only value lets you exercise
# the signed test-webhook flow while DVAs stay in sandbox mode.
# PAYSTACK_WEBHOOK_SECRET=sk_test_<your-test-secret-key>

# ── Phase-2 Module 8A: Client Portal (/portal/{secureToken}) ──
# (Module 8A default; overridden by the STAGE 9A PRODUCTION block below.)
# PORTAL_BASE_URL=https://app.okomba.com

# ── Phase-2 Module 8B: Cloudinary PDF storage ──────────────────
# Preferred: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Phase-2 Module 8B: Google Drive daily backup ───────────────
# GOOGLE_SERVICE_ACCOUNT_JSON=   (or GOOGLE_SERVICE_ACCOUNT_B64=)
# GOOGLE_DRIVE_FOLDER_ID=
BACKUP_CRON_ENABLED=true
# BACKUP_CRON_EXPR=0 2 * * *

# ── Phase-2 Module 8C: GA4 + first-party analytics ─────────────
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ═══════════════════════════════════════════════════════════════
# STAGE 9A — PRODUCTION CONFIG (okomba.com launch)
# Set EVERY marked [PROD] var in Render → Environment before the
# first real customer is sent a proposal. See docs/RUNBOOK.md for
# the full launch checklist (domain, SSL, UptimeRobot, Paystack
# LIVE, GA4 verify, restore-from-backup SOP).
# ═══════════════════════════════════════════════════════════════

# [PROD] Public site URL — used to build portal + confirmation links.
# Stage 9 target: https://okomba.com
NEXT_PUBLIC_SITE_URL=https://okomba.com

# [PROD] Portal base URL — the public host that serves /portal/{token}.
# Defaults to NEXT_PUBLIC_SITE_URL when unset; set both to the live domain.
PORTAL_BASE_URL=https://okomba.com

# [PROD] Admin login + alert recipient. Double-duty: the email is the
# login identity AND the inbox that receives system.alert emails
# (cloudinary fallback, backup failure, payment-proof-uploaded).
ADMIN_EMAIL=founder@okomba.com
ADMIN_PASSWORD=replace-with-a-32-char-strong-secret

# [PROD] Paystack LIVE keys (switch from sk_test_ to sk_live_).
# Paystack dashboard → Settings → API & Webhooks → API Keys (LIVE tab).
PAYSTACK_SECRET_KEY=sk_live_<your-live-secret-key>
PAYSTACK_PUBLIC_KEY=pk_live_<your-live-public-key>
# Same value as PAYSTACK_SECRET_KEY (Paystack signs webhooks with the
# secret key of whichever mode the dashboard is in).
PAYSTACK_WEBHOOK_SECRET=sk_live_<same-as-secret-key>

# [PROD] Cloudinary — proposal PDF storage (Module 8B).
# Preferred form: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Fallback: CLOUDINARY_CLOUD_NAME + CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET.
# Unconfigured → PDFs stored locally + admin alert (pipeline never breaks).
CLOUDINARY_URL=cloudinary://xxxxxxxx:xxxxxxxx@okomba

# [PROD] Google Drive daily 02:00 WAT backup (Module 8B).
# Create a service account, share the Drive folder with its email,
# then paste the JSON (single line, escaped) or base64-encode it.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_DRIVE_FOLDER_ID=

# [PROD] GA4 measurement ID (Module 8C). Create the property at
# https://analytics.google.com, copy the G-XXXXXX string. Without it
# the first-party AnalyticsEvent table still powers the dashboard.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# [PROD] Google Apps Script Web App URL — every outbound email is
# forwarded here (inquiry alerts, proposals, receipts, broadcasts).
# Deploy Google-apps-script/Code.gs → paste the /exec URL.
NOTIFY_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# UptimeRobot — monitor GET /api/health every 5 min (free tier).
# No env var required; configure at https://uptimerobot.com with
# monitor URL = https://okomba.com/api/health

# WhatsApp mini-service connection (Render internal network).
WHATSAPP_SERVICE_URL=http://okomba-whatsapp:3004
WHATSAPP_INTERNAL_TOKEN=replace-with-32-char-shared-secret

# [PROD] PII GOVERNANCE — set to "true" if your internal policy (or a
# customer's DPA, or a regulator's guidance) prohibits sending customer
# spreadsheet PII to the third-party z-ai-web-dev-sdk LLM during CRM
# import. The import route then skips the LLM call entirely and uses
# the deterministic header-name heuristic mapper only. See the "PII
# GOVERNANCE" section above + src/app/api/admin/customers/import/route.ts
# for the full rationale. Default (unset or "false"): LLM is used.
# CRM_IMPORT_NO_LLM=false

# ═══════════════════════════════════════════════════════════════
# CODE-LEVEL ENV REFERENCE (auto-audited — every var the server reads)
# ═══════════════════════════════════════════════════════════════
# Below is the complete list of env vars read by the codebase
# (excluding NODE_ENV / NEXT_RUNTIME / PORT which are host-supplied)
# with their fallback behavior when unset. The site will boot with
# only DATABASE_URL + ADMIN_EMAIL + ADMIN_PASSWORD set — every other
# var degrades gracefully (logs an info notice and continues).
#
# ┌──────────────────────────────────────┬─────────────────────────────────────┐
# │ Var                                   │ Fallback when unset                │
# ├──────────────────────────────────────┼─────────────────────────────────────┤
# │ DATABASE_URL                          │ REQUIRED — app will not boot       │
# │ ADMIN_EMAIL / ADMIN_PASSWORD         │ Refuses prod login (503)           │
# │ NEXT_PUBLIC_SITE_URL                 │ Defaults to https://okomba.com      │
# │ PORTAL_BASE_URL                      │ Falls back to NEXT_PUBLIC_SITE_URL  │
# │ NOTIFY_WEBHOOK_URL                   │ Logs to console only (no email)     │
# │ NOTIFICATIONS_ENABLED                │ Defaults to true (set "false" off) │
# │ PAYSTACK_SECRET_KEY                  │ Sandbox DVA (clearly labelled)      │
# │ PAYSTACK_WEBHOOK_SECRET               │ Falls back to PAYSTACK_SECRET_KEY   │
# │ PAYSTACK_PREFERRED_BANK_NG           │ Falls back to PAYSTACK_PREFERRED_BANK│
# │ PAYSTACK_PREFERRED_BANK_GH           │ Falls back to PAYSTACK_PREFERRED_BANK│
# │ PAYSTACK_PREFERRED_BANK              │ Per-country default (NG: wema-bank, │
# │                                       │ GH: zenithmobilemoneyprovider)     │
# │ CLOUDINARY_URL                       │ Local PDF storage + admin alert     │
# │ CLOUDINARY_CLOUD_NAME+API_KEY+SECRET │ Used if CLOUDINARY_URL unset         │
# │ GOOGLE_SERVICE_ACCOUNT_JSON          │ Skips Drive backup, logs alert       │
# │ GOOGLE_SERVICE_ACCOUNT_B64           │ Alt encoding (decoded base64)       │
# │ GOOGLE_DRIVE_FOLDER_ID               │ Skips Drive backup, logs alert       │
# │ BACKUP_CRON_ENABLED                  │ Defaults to true                    │
# │ BACKUP_CRON_EXPR                     │ Defaults to "0 2 * * *" (02:00 WAT) │
# │ REMINDER_CRON_ENABLED                │ Defaults to true                    │
# │ REMINDER_CRON_EXPR                   │ Defaults to "0 9 * * *" (09:00 WAT) │
# │ CRON_SELF_PING_ENABLED               │ Defaults to false (opt-in)          │
# │ CRON_SELF_PING_EXPR                  │ Defaults to "0 */9 * * * *"         │
# │ SELF_PING_URL                        │ Falls back to NEXT_PUBLIC_SITE_URL   │
# │ NEXT_PUBLIC_GA4_MEASUREMENT_ID       │ No GA4 tag (first-party only)       │
# │ NEXT_PUBLIC_DEV_CONFIRM_SIMULATION   │ Defaults to true in dev (opt-out)   │
# │ WHATSAPP_SERVICE_URL                 │ Defaults to http://localhost:3004    │
# │ WHATSAPP_INTERNAL_TOKEN              │ Defaults to "okomba-internal-dev"   │
# │ PAYSTACK_PUBLIC_KEY                  │ Not read by server code (kept for   │
# │                                       future client-side checkout)         │
# │ EMAIL_CONFIG_ENCRYPTION_KEY          │ PBKDF2 over ADMIN_PASSWORD (dev     │
# │                                       only — production MUST set the key) │
# │ EMAIL_TEST_TO                        │ Falls back to ADMIN_EMAIL            │
# │ CRM_IMPORT_NO_LLM                    │ Defaults to false — LLM used for CRM │
# │                                       import column mapping (true/1 =     │
# │                                       deterministic-only, no PII egress)  │
# └──────────────────────────────────────┴─────────────────────────────────────┘
# Source of truth: src/lib/{paystack,payment-webhook,notify,cloudinary,
# backup,cron,whatsapp,email-config,email-failover}.ts +
# src/app/api/{admin/login,subscribe,admin/customers/import,admin/email-config} routes.
