# Okomba Analytics — environment configuration
# Copy to .env and adjust values. NEVER commit the real .env file.

# SQLite database location (Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Admin portal credentials — REQUIRED in production.
# If unset, source-level dev defaults are used (see src/app/api/admin/login/route.ts).
# Always override these when deploying publicly.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Email notifications (Google Apps Script pattern) ─────────
# Deploy Google-apps-script/Code.gs as a Web App (see docs/DEPLOYMENT.md),
# then paste the Web App URL here — every notification (inquiry alerts +
# confirmations, subscriber double-opt-in, new-post blasts, broadcasts)
# is forwarded there and sent via your Gmail. Leave unset to log-only.
# NOTIFY_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Public site URL — used to build confirmation links in emails.
NEXT_PUBLIC_SITE_URL=https://www.okomba.com

# Set to "false" to silence all outbound notifications entirely.
# NOTIFICATIONS_ENABLED=true
